# Copy to deploy/.env and edit. Paths are on the host.
DATA_DIR=/srv/projektor/data
MOVIES_DIR=/srv/media/movies
TV_DIR=/srv/media/tv
ANIME_DIR=/srv/media/anime

# Optional tuning (defaults shown)
# HLS_MAX_TRANSCODES=2
# HLS_IDLE_MS=60000
# SCAN_DEBOUNCE_MS=5000
# HARDWARE_ACCEL=auto        # auto | vaapi | none
# LOG_LEVEL=info
# IPTV_URL=http://playshare.co:8080/   # Xtream Codes provider; username and password go in Settings
# LIVE_MAX_STREAMS=2               # concurrent IPTV connections; match the account's limit
# AUTH_RATE_LIMIT=20               # login attempts per IP per minute
# RECORDINGS_DIR=/srv/projektor/data/recordings   # where live recordings are written (default DATA_DIR/recordings)
# RECORDING_PADDING_MS=120000     # keep recording this long after a programme's guide end
